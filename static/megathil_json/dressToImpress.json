            {
                "moduleName": "Dress To Impress",
                "totalInstruction": 5,
                "completedInstruction": 2,
                "questionType": "INSTRUCTIONS",
                "templateType": "highLightInstruction",
                "quetionTitle": "what clothing can you wear on your important day?",
                "hintText": "And in the mirror, you will find looking at a smart, handsome and confident candidate who will start their career soon in a big organisation! THAT’s YOU!",
                "hintImage": "",
                "displayOrder": 2,
                "hasMultiAnswers": true,
                "imageUrl": "dads",
                "option": [
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "",
                        "optionText": "If you prefer dressing up in Indian attire, Invest in a neutral colour, simple patterned right-fit salwar suits with cotton dupattas neatly pinned so that you do not have the hassle of adjusting them.",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifinst1.png",
                        "validOption": false,
                        "displayOrder": 1
                    },
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "",
                        "optionText": "If you are comfortable with western clothing, get yourself perfectly fitting trousers and a smart shirt (neutral or light colours with very simple patterns like thin stripes or checks)",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifinst2.png",
                        "validOption": false,
                        "displayOrder": 2
                    },
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "",
                        "optionText": "If you chose to wear skirts, ensure the hem falls no higher than just above the knee so when you sit down in the chair, you feel comfortable and the skirt remains at a respectable length. Pair it with a smart top or a shirt",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifinst3.png",
                        "validOption": false,
                        "displayOrder": 3
                    },
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "",
                        "optionText": "And in the mirror, you will find looking at a smart, handsome and confident candidate who will start their career soon in a big organisation! THAT’s YOU!",
