                    }
                ]
            },
            {
                "moduleName": "Dress To Impress",
                "questionId": "6592008029c8c3e4dc76tgy5",
                "moduleId": "6592008029c8c3e4dc76256c",
                "totalInstruction": 5,
                "completedInstruction": 3,
                "questionType": "INSTRUCTIONS",
                "templateType": "doView",
                "quetionTitle": "DO’S",
                "displayOrder": 2,
                "hasMultiAnswers": true,
                "hintText": "",
                "option": [
                    {
                        "optionId": "6592008029c8c3e4dc769871",
                        "optionValue": "Keep your hair tied back, avoid hairstyle that covers your face and eyes.",
                        "optionText": "Hair and Face",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdos1.png",
                        "validOption": true,
                        "displayOrder": 1
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769872",
                        "optionValue": "Wear simple professional looking footwear that complements your clothes and not something flashy that will grab attention to your foot.",
                        "optionText": "Footwear",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdos2.png",
                        "validOption": true,
                        "displayOrder": 2
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "With that smart look, you could also wear a classic wrist watch with a metal or leather band (again not very bright, but neutral colours)",
                        "optionText": "Accessories",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdos3.png",
                        "validOption": true,
                        "displayOrder": 3
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Makeup should be conservative with a neutral lipstick and should match your complexion.",
                        "optionText": "Makeup",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdos4.png",
                        "validOption": true,
                        "displayOrder": 4
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Keep your nails trimmed and clean and if you have nail polish, keep the colors toned down. Apply moisturiser so your hands and feet don’t look dry.",
                        "optionText": "Nails and Skincare",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdos5.png",
                        "validOption": true,
                        "displayOrder": 5
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Try on your complete outfit before the interview to assess your own looks before you head to your big day!",
                        "optionText": "Trial Once",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdos6.png",
                        "validOption": true,
                        "displayOrder": 6
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Be prepared the night before to check for any issues with your clothes.",
                        "optionText": "Adjust",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdos7.png",
                        "validOption": true,
                        "displayOrder": 7
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Also have a back up plan in place and have a second set of clothing ready just in case you face any challenges with your initial planned look for the interview",
                        "optionText": "Be Ready with plan B",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdos8.png",
                        "validOption": true,
                        "displayOrder": 8
                    }
                ]
            },
            {
                "moduleName": "Dress To Impress",
                "questionId": "6592008029c8c3e4dc76tgy5",
                "moduleId": "6592008029c8c3e4dc76256c",
                "totalInstruction": 5,
                "completedInstruction": 4,
                "questionType": "INSTRUCTIONS",
                "templateType": "dontView",
                "quetionTitle": "5 Strict DON’TS to follow",
                "displayOrder": 2,
                "hasMultiAnswers": true,
                "hintText": "",
                "option": [
                    {
                        "optionId": "6592008029c8c3e4dc769871",
                        "optionValue": "",
                        "optionText": "Do not wear jeans, tank tops, T-shirts or even shirts with thin straps.",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdont1.png",
                        "validOption": true,
                        "displayOrder": 1
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769872",
                        "optionValue": "",
                        "optionText": "No Slippers, flip flops and other open toed sandals",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdont2.png",
                        "validOption": true,
                        "displayOrder": 2
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "",
                        "optionText": "Avoid big prints, floral designs in your clothes – basically avoid anything that can cause distractions and unwanted attention",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdont3.png",
                        "validOption": true,
                        "displayOrder": 3
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "",
                        "optionText": "Strong perfumes in small spaces may be more of a nuisance for an interviewer, So a big no to strong smells",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdont4.png",
                        "validOption": true,
                        "displayOrder": 4
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "",
                        "optionText": "Remove any Jewellery like bangles, charm bracelets, loud anklets large hoops or big earrings that can cause noise and annoy the interviewer and might become a cause of distraction or bias",
                        "optionImage": "${IMAGE_URL}/masserts/module2/female/ifdont5.png",
                        "validOption": true,
                        "displayOrder": 5
                    }
                ]
            },
