            {
                "moduleName": "Dress To Impress",
                "totalInstruction": 5,
                "completedInstruction": 2,
                "questionType": "INSTRUCTIONS",
                "templateType": "highLightInstruction",
                "quetionTitle": "What clothing can you wear on your important day?",
                "hintText": "And in the mirror, you will find looking at a smart, handsome and confident candidate who will start their career soon in a big organisation! THAT’s YOU!",
                "hintImage": "",
                "displayOrder": 2,
                "hasMultiAnswers": true,
                "imageUrl": "dads",
                "option": [
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "",
                        "optionText": "Collared shirts with long sleeves – light coloured, neatly ironed, button-down and tucked in Shirt with long sleeves and collared is ideal.White shirt if clean and bright is a great choice as this can never go wrong, if not go for other light colours",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/iminst1.png",
                        "validOption": false,
                        "displayOrder": 1
                    },
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "",
                        "optionText": "Cotton pants or formal pants with neutral colours like grey, black, brown or navy blue is preferrable to make you look professional",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/iminst2.png",
                        "validOption": false,
                        "displayOrder": 2
                    },
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "",
                        "optionText": "Invest in a decent black or brown formal shoes with similar coloured socks ",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/iminst3.png",
                        "validOption": false,
                        "displayOrder": 3
                    },
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "",
                        "optionText": "And in the mirror, you will find looking at a smart, handsome and confident candidate who will start their career soon in a big organisation! THAT’s YOU!",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/iminst4.png",
                        "validOption": true,
                        "displayOrder": 3
                    }
                ]
            },
            {
                "moduleName": "Dress To Impress",
                "totalInstruction": 5,
                "completedInstruction": 3,
                "questionId": "6592008029c8c3e4dc76tgy5",
                "moduleId": "6592008029c8c3e4dc76256c",
                "questionType": "INSTRUCTIONS",
                "templateType": "doView",
                "quetionTitle": "DO’S",
                "displayOrder": 2,
                "hasMultiAnswers": true,
                "hintText": "",
                "option": [
                    {
                        "optionId": "6592008029c8c3e4dc769871",
                        "optionValue": "With that smart look, you could also wear a classic wrist watch with a metal or leather band (again not very bright, but neutral colours)",
                        "optionText": "Accessories",
                        "validOption": true,
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdos1.png",
                        "displayOrder": 1
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769872",
                        "optionValue": "Always wear a leather belt that closely matches your shoes",
                        "optionText": "Belt it Right",
                        "validOption": true,
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdos2.png",
                        "displayOrder": 2
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Keep your hair tied back, avoid hairstyle that covers your face and eyes.",
                        "optionText": "Hair Cut",
                        "validOption": true,
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdos3.png",
                        "displayOrder": 3
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Keep your nails trimmed and clean and apply moisturizer so your hands don’t look dry",
                        "optionText": "Attention to Detail",
                        "validOption": true,
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdos4.png",
                        "displayOrder": 4
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Try on your complete outfit before the interview to assess your own looks before you head to your big day!",
                        "optionText": "Dress Rehearsal",
                        "validOption": true,
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdos5.png",
                        "displayOrder": 5
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Be prepared the night before to check for any issues with your clothes.",
                        "optionText": "Dress Night Before Preparations",
                        "validOption": true,
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdos6.png",
                        "displayOrder": 6
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "Also have a back up plan in place and have a second set of clothing ready just in case you face any challenges with your initial planned look for the interview",
                        "optionText": "Be Ready with plan B",
                        "validOption": true,
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdos7.png",
                        "displayOrder": 7
                    }
                ]
            },
            {
                "moduleName": "Dress To Impress",
                "totalInstruction": 5,
                "completedInstruction": 4,
                "questionId": "6592008029c8c3e4dc76tgy5",
                "moduleId": "6592008029c8c3e4dc76256c",
                "questionType": "INSTRUCTIONS",
                "templateType": "dontView",
                "quetionTitle": "5 Strict DON’TS to follow",
                "displayOrder": 2,
                "hasMultiAnswers": true,
                "hintText": "",
                "option": [
                    {
                        "optionId": "6592008029c8c3e4dc769871",
                        "optionValue": "",
                        "optionText": "Do not wear jeans, tanktops, TShirts, leggings (Kurta leggings is fine as long as the sides look neat and not revealing) and low-cut or transparent tops",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdont1.png",
                        "validOption": true,
                        "displayOrder": 1
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769872",
                        "optionValue": "",
                        "optionText": "No Slippers, flip flops and other open toed sandals",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdont2.png",
                        "validOption": true,
                        "displayOrder": 2
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "",
                        "optionText": "Avoid athletic socks and white ones",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdont3.png",
                        "validOption": true,
                        "displayOrder": 3
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "",
                        "optionText": "Strong perfumes in small spaces may be more of a nuisance for an interviewer, So a big no to strong smells",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdont4.png",
                        "validOption": true,
                        "displayOrder": 4
                    },
                    {
                        "optionId": "6592008029c8c3e4dc769873",
                        "optionValue": "",
                        "optionText": "Remove any Jewelry which might be a cause of distraction or bias for your interviewer",
                        "optionImage": "${IMAGE_URL}/masserts/module2/male/imdont5.png",
                        "validOption": true,
                        "displayOrder": 5
                    }
                ]
            },
