                "option": [
                    {
                        "optionId": "6592008029c8c3e4dc76jhgt",
                        "optionValue": "Candidate",
                        "optionText": "Hi, I'm [Your Name]. I recently graduated with a degree in [Your Field] from [University Name], where I gained hands-on experience through internships in [relevant field]. I'm excited to kickstart my career and apply my skills to [specific industry or role].",
                        "optionImage": "",
                        "validOption": true,
